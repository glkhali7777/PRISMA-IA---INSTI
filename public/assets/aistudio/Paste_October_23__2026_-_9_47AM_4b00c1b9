
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PRISMA IA — Terminal Institucional</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap');

  :root {
    --bg: #04040c;
    --bg2: #07071a;
    --card: #0b0b20;
    --card2: #0e0e28;
    --border: #1a1a40;
    --border2: #252550;
    --text: #c8c8e8;
    --text2: #7070a0;
    --text3: #4040608;
    --call: #00e676;
    --put: #ff1744;
    --neutral: #ffd600;
    --purple: #ce93d8;
    --blue: #64b5f6;
    --cyan: #4dd0e1;
    --orange: #ff8a65;
    --accumulation: #64b5f6;
    --expansion: #69f0ae;
    --distribution: #ff8a65;
    --manipulation: #ce93d8;
    --rebalancing: #4dd0e1;
    --reversal: #ef9a9a;
    --optimal: #00e676;
    --good: #69f0ae;
    --wait: #ffd600;
    --avoid: #ff1744;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* SCANLINES overlay */
  body::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
    pointer-events: none;
    z-index: 9999;
  }

  /* HEADER */
  #header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: linear-gradient(180deg, #04040c 0%, rgba(4,4,12,0.98) 100%);
    border-bottom: 1px solid var(--border2);
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .logo {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 800;
    background: linear-gradient(90deg, #ce93d8, #64b5f6, #69f0ae);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .logo span {
    font-size: 10px;
    font-weight: 400;
    color: var(--text2);
    -webkit-text-fill-color: var(--text2);
    margin-left: 8px;
    letter-spacing: 1px;
  }

  select, input[type="text"] {
    background: var(--card);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 5px 10px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  select:hover, input:hover { border-color: var(--purple); }

  .btn {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 5px 12px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .btn:hover { border-color: var(--purple); color: var(--purple); background: rgba(206,147,216,0.05); }
  .btn.active { border-color: var(--call); color: var(--call); background: rgba(0,230,118,0.08); }
  .btn.danger { border-color: var(--put); color: var(--put); }
  .btn.scan-btn { border-color: var(--cyan); color: var(--cyan); }
  .btn.scan-btn:hover { background: rgba(77,208,225,0.08); }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--call);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0,230,118,0.4); }
    50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(0,230,118,0); }
  }

  .status-dot.loading { background: var(--neutral); animation: pulse-yellow 1s infinite; }
  @keyframes pulse-yellow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .price-ticker {
    font-size: 14px;
    font-weight: 700;
    color: var(--call);
    font-family: 'Syne', sans-serif;
  }

  .price-change {
    font-size: 11px;
    color: var(--call);
  }

  .price-change.neg { color: var(--put); }

  .header-spacer { flex: 1; }

  .refresh-info {
    font-size: 10px;
    color: var(--text2);
    white-space: nowrap;
  }

  /* LANGUAGE TOGGLE */
  .lang-btn {
    background: var(--card);
    border: 1px solid var(--border2);
    color: var(--text2);
    padding: 4px 8px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .lang-btn.active { border-color: var(--purple); color: var(--purple); }

  /* MAIN GRID */
  #main {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    gap: 8px;
    padding: 8px;
    min-height: calc(100vh - 52px);
  }

  /* CARDS */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--purple), transparent);
    opacity: 0.4;
  }

  .card-title {
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text2);
    text-transform: uppercase;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-title .dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--purple);
  }

  /* LEFT COLUMN */
  #left-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* SIGNAL CARD */
  #signal-card {
    text-align: center;
    padding: 16px 12px;
  }

  .signal-direction {
    font-family: 'Syne', sans-serif;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: 4px;
    text-shadow: 0 0 30px currentColor;
    transition: all 0.5s;
  }

  .signal-direction.CALL { color: var(--call); }
  .signal-direction.PUT { color: var(--put); }
  .signal-direction.NEUTRAL { color: var(--neutral); }
  .signal-direction.AGUARDAR { color: var(--neutral); }

  .signal-asset {
    font-size: 11px;
    color: var(--text2);
    margin-top: 2px;
    letter-spacing: 2px;
  }

  .confidence-ring {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 12px auto;
  }

  .confidence-ring svg {
    transform: rotate(-90deg);
  }

  .confidence-ring .conf-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
  }

  .confidence-ring .conf-label {
    position: absolute;
    bottom: 12px; left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    color: var(--text2);
    letter-spacing: 1px;
  }

  .signal-entry-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
    margin-top: 10px;
  }

  .entry-box {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 6px 4px;
    text-align: center;
  }

  .entry-box .eb-label {
    font-size: 9px;
    color: var(--text2);
    letter-spacing: 1px;
    margin-bottom: 3px;
  }

  .entry-box .eb-val {
    font-size: 11px;
    font-weight: 700;
    font-family: 'Syne', sans-serif;
  }

  .entry-box .eb-val.sl { color: var(--put); }
  .entry-box .eb-val.tp { color: var(--call); }
  .entry-box .eb-val.entry { color: var(--neutral); }

  /* DELIVERY PHASE */
  .phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 3px;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    border: 1px solid;
    margin-bottom: 8px;
  }

  .phase-ACCUMULATION { color: var(--accumulation); border-color: var(--accumulation); background: rgba(100,181,246,0.08); }
  .phase-EXPANSION { color: var(--expansion); border-color: var(--expansion); background: rgba(105,240,174,0.08); }
  .phase-DISTRIBUTION { color: var(--distribution); border-color: var(--distribution); background: rgba(255,138,101,0.08); }
  .phase-MANIPULATION { color: var(--manipulation); border-color: var(--manipulation); background: rgba(206,147,216,0.08); }
  .phase-REBALANCING { color: var(--rebalancing); border-color: var(--rebalancing); background: rgba(77,208,225,0.08); }
  .phase-REVERSAL { color: var(--reversal); border-color: var(--reversal); background: rgba(239,154,154,0.08); }

  .phase-timeline {
    display: flex;
    gap: 4px;
    margin: 8px 0;
    align-items: center;
  }

  .phase-step {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--border2);
    transition: background 0.5s;
  }

  .phase-step.active { background: var(--purple); }
  .phase-step.done { background: var(--call); }

  /* HTF BIAS */
  .htf-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
  }

  .htf-row:last-child { border-bottom: none; }

  .htf-label { color: var(--text2); font-size: 11px; }

  .bias-tag {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 2px;
  }

  .bias-BULLISH { color: var(--call); background: rgba(0,230,118,0.1); border: 1px solid rgba(0,230,118,0.3); }
  .bias-BEARISH { color: var(--put); background: rgba(255,23,68,0.1); border: 1px solid rgba(255,23,68,0.3); }
  .bias-NEUTRAL { color: var(--neutral); background: rgba(255,214,0,0.1); border: 1px solid rgba(255,214,0,0.3); }

  /* ENGINE VOTES */
  .engine-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }

  .engine-row:last-child { border-bottom: none; }

  .engine-name { flex: 1; color: var(--text2); font-size: 10px; }

  .vote-bar {
    width: 60px;
    height: 4px;
    background: var(--border2);
    border-radius: 2px;
    overflow: hidden;
  }

  .vote-fill { height: 100%; border-radius: 2px; transition: width 0.5s; }
  .vote-fill.call { background: var(--call); }
  .vote-fill.put { background: var(--put); }
  .vote-fill.neutral { background: var(--neutral); }

  .vote-val {
    font-size: 10px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    min-width: 28px;
    text-align: right;
  }

  /* CENTER COLUMN */
  #center-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* CHART */
  #chart-container {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px;
    height: 340px;
    position: relative;
    overflow: hidden;
  }

  #chart-canvas {
    width: 100%;
    height: 260px;
    display: block;
  }

  .chart-overlay-labels {
    position: absolute;
    top: 30px; left: 12px; right: 12px;
    pointer-events: none;
  }

  .chart-label {
    position: absolute;
    font-size: 9px;
    font-family: 'Space Mono', monospace;
    background: rgba(11,11,32,0.9);
    border: 1px solid;
    padding: 2px 5px;
    border-radius: 2px;
    white-space: nowrap;
    pointer-events: none;
  }

  /* SCENARIO */
  .scenario-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
  }

  .scenario-box {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 8px;
  }

  .scenario-box .s-label {
    font-size: 9px;
    color: var(--text2);
    letter-spacing: 1px;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .scenario-box .s-prob {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 800;
  }

  .scenario-box .s-narr {
    font-size: 9px;
    color: var(--text2);
    margin-top: 4px;
    line-height: 1.4;
  }

  .s-bull .s-prob { color: var(--call); }
  .s-bear .s-prob { color: var(--put); }
  .s-neut .s-prob { color: var(--neutral); }

  .prob-bar-outer {
    width: 100%;
    height: 3px;
    background: var(--border2);
    border-radius: 2px;
    margin-top: 4px;
    overflow: hidden;
  }

  .prob-bar-inner { height: 100%; border-radius: 2px; transition: width 0.8s ease; }
  .s-bull .prob-bar-inner { background: var(--call); }
  .s-bear .prob-bar-inner { background: var(--put); }
  .s-neut .prob-bar-inner { background: var(--neutral); }

  /* NARRATIVE */
  #narrative-box {
    background: var(--bg2);
    border: 1px solid var(--border2);
    border-left: 3px solid var(--purple);
    border-radius: 3px;
    padding: 10px 12px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--text);
    min-height: 80px;
    white-space: pre-line;
  }

  /* RIGHT COLUMN */
  #right-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* FUNDING / OI */
  .gauge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .gauge-label { font-size: 10px; color: var(--text2); }
  .gauge-value {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 700;
  }

  .gauge-bar {
    width: 100%;
    height: 6px;
    background: var(--border2);
    border-radius: 3px;
    overflow: hidden;
    margin: 4px 0 8px;
    position: relative;
  }

  .gauge-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.8s ease;
  }

  /* LIQUIDITY ZONES */
  .zone-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    border-radius: 3px;
    margin-bottom: 3px;
    font-size: 10px;
    border: 1px solid transparent;
  }

  .zone-item.support { background: rgba(0,230,118,0.06); border-color: rgba(0,230,118,0.2); }
  .zone-item.resistance { background: rgba(255,23,68,0.06); border-color: rgba(255,23,68,0.2); }
  .zone-item.neutral-z { background: rgba(255,255,255,0.03); border-color: var(--border); }

  .zone-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .zone-item.support .zone-dot { background: var(--call); }
  .zone-item.resistance .zone-dot { background: var(--put); }
  .zone-item.neutral-z .zone-dot { background: var(--text2); }

  .zone-price { font-family: 'Syne', sans-serif; font-weight: 700; flex: 1; }
  .zone-str { font-size: 9px; color: var(--text2); }

  /* ORDER BLOCKS */
  .ob-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    border-radius: 3px;
    margin-bottom: 3px;
    border: 1px solid transparent;
    font-size: 10px;
  }

  .ob-item.bull-ob { background: rgba(0,230,118,0.06); border-color: rgba(0,230,118,0.25); }
  .ob-item.bear-ob { background: rgba(255,23,68,0.06); border-color: rgba(255,23,68,0.25); }

  .ob-range { font-family: 'Syne', sans-serif; font-size: 10px; }
  .ob-bull-ob .ob-range { color: var(--call); }
  .ob-bear-ob .ob-range { color: var(--put); }

  .ob-type {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 700;
  }

  .bull-ob .ob-type { color: var(--call); background: rgba(0,230,118,0.15); }
  .bear-ob .ob-type { color: var(--put); background: rgba(255,23,68,0.15); }

  /* SMC TAGS */
  .smc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  .smc-tag {
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 2px;
    border: 1px solid;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .tag-bos { color: var(--call); border-color: var(--call); background: rgba(0,230,118,0.08); }
  .tag-choch { color: var(--purple); border-color: var(--purple); background: rgba(206,147,216,0.08); }
  .tag-fvg { color: var(--cyan); border-color: var(--cyan); background: rgba(77,208,225,0.08); }
  .tag-sweep { color: var(--neutral); border-color: var(--neutral); background: rgba(255,214,0,0.08); }
  .tag-eqh { color: var(--blue); border-color: var(--blue); background: rgba(100,181,246,0.08); }
  .tag-eql { color: var(--blue); border-color: var(--blue); background: rgba(100,181,246,0.08); }
  .tag-inducement { color: var(--orange); border-color: var(--orange); background: rgba(255,138,101,0.08); }

  /* WHALE PANEL */
  .whale-event {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 10px;
  }

  .whale-event:last-child { border-bottom: none; }

  .whale-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
  .whale-info { flex: 1; }
  .whale-title { color: var(--text); line-height: 1.4; }
  .whale-meta { color: var(--text2); font-size: 9px; margin-top: 2px; }
  .whale-impact { font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700; white-space: nowrap; }
  .whale-impact.bull { color: var(--call); }
  .whale-impact.bear { color: var(--put); }
  .whale-impact.neut { color: var(--text2); }

  /* NEWS PANEL */
  .news-item {
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 10px;
  }

  .news-item:last-child { border-bottom: none; }

  .news-title {
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 3px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .news-impact {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 700;
    border: 1px solid;
  }

  .impact-EXTREME { color: var(--put); border-color: var(--put); background: rgba(255,23,68,0.1); }
  .impact-HIGH { color: var(--orange); border-color: var(--orange); background: rgba(255,138,101,0.1); }
  .impact-MEDIUM { color: var(--neutral); border-color: var(--neutral); background: rgba(255,214,0,0.1); }
  .impact-LOW { color: var(--text2); border-color: var(--text2); background: rgba(112,112,160,0.1); }

  .news-sentiment {
    font-size: 9px;
    font-weight: 700;
    font-family: 'Syne', sans-serif;
  }

  .sent-BULLISH { color: var(--call); }
  .sent-BEARISH { color: var(--put); }
  .sent-NEUTRAL { color: var(--text2); }

  .news-src { font-size: 9px; color: var(--text2); margin-left: auto; }

  /* CORRELATION MATRIX */
  .corr-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid var(--border);
    font-size: 10px;
  }

  .corr-row:last-child { border-bottom: none; }
  .corr-label { flex: 1; color: var(--text2); font-size: 10px; }
  .corr-bar { width: 80px; height: 4px; background: var(--border2); border-radius: 2px; overflow: visible; position: relative; }

  .corr-fill {
    position: absolute;
    height: 100%;
    top: 0;
    border-radius: 2px;
    transition: all 0.8s ease;
  }

  .corr-val { font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700; min-width: 38px; text-align: right; }

  /* LIQUIDATION HEATMAP */
  .liq-heat-bar {
    width: 100%;
    height: 18px;
    background: linear-gradient(90deg, rgba(255,23,68,0.15), rgba(255,23,68,0.05), transparent, rgba(0,230,118,0.05), rgba(0,230,118,0.15));
    border-radius: 3px;
    position: relative;
    margin: 8px 0;
  }

  .liq-marker {
    position: absolute;
    top: -4px;
    width: 2px;
    height: 26px;
    border-radius: 1px;
    transition: left 0.8s ease;
  }

  .liq-marker.current { background: var(--neutral); }
  .liq-marker.long-liq { background: var(--put); }
  .liq-marker.short-liq { background: var(--call); }

  .liq-cluster {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    border-radius: 3px;
    margin-bottom: 3px;
    font-size: 10px;
    border: 1px solid transparent;
  }

  .liq-cluster.long { background: rgba(255,23,68,0.06); border-color: rgba(255,23,68,0.2); }
  .liq-cluster.short { background: rgba(0,230,118,0.06); border-color: rgba(0,230,118,0.2); }

  /* SCANNER */
  .scanner-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px;
    border-radius: 3px;
    margin-bottom: 3px;
    background: var(--bg2);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s;
    font-size: 10px;
  }

  .scanner-item:hover { border-color: var(--purple); background: rgba(206,147,216,0.04); }

  .scanner-rank {
    font-size: 9px;
    color: var(--text2);
    min-width: 16px;
    text-align: right;
  }

  .scanner-sym {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    min-width: 56px;
    color: var(--text);
  }

  .scanner-score {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    min-width: 35px;
  }

  .scanner-phase { flex: 1; }

  /* ADAPTIVE LEARNING */
  .learn-stat {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }

  .learn-stat:last-child { border-bottom: none; }
  .learn-stat .lbl { color: var(--text2); }
  .learn-stat .val { font-family: 'Syne', sans-serif; font-weight: 700; }

  /* MANIPULATION ALERT */
  .manip-alert {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px;
    border-radius: 3px;
    border: 1px solid;
    margin-bottom: 6px;
  }

  .manip-alert.detected { border-color: rgba(255,23,68,0.4); background: rgba(255,23,68,0.06); }
  .manip-alert.clean { border-color: rgba(0,230,118,0.3); background: rgba(0,230,118,0.04); }
  .manip-alert.warning { border-color: rgba(255,214,0,0.4); background: rgba(255,214,0,0.06); }

  .manip-icon { font-size: 18px; flex-shrink: 0; }
  .manip-type {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .manip-desc { font-size: 10px; color: var(--text2); margin-top: 3px; line-height: 1.4; }
  .manip-rec { font-size: 10px; font-weight: 700; margin-top: 4px; }

  /* EXECUTION TIMING */
  .exec-quality {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 3px;
    border: 1px solid;
    display: inline-block;
    margin-bottom: 8px;
    letter-spacing: 1px;
  }

  .eq-OPTIMAL { color: var(--optimal); border-color: var(--optimal); background: rgba(0,230,118,0.1); }
  .eq-GOOD { color: var(--good); border-color: var(--good); background: rgba(105,240,174,0.08); }
  .eq-WAIT { color: var(--wait); border-color: var(--wait); background: rgba(255,214,0,0.08); }
  .eq-AVOID { color: var(--avoid); border-color: var(--avoid); background: rgba(255,23,68,0.08); }

  .exec-detail {
    font-size: 10px;
    color: var(--text2);
    line-height: 1.6;
  }

  /* DELTA / CVD */
  #cvd-canvas { width: 100%; height: 70px; display: block; }

  .delta-info {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 11px;
  }

  /* HISTORICAL SIMILARITY */
  .hist-match {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 10px;
  }

  .hist-match:last-child { border-bottom: none; }

  .hist-sim {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    min-width: 38px;
  }

  .hist-info { flex: 1; }
  .hist-period { color: var(--text); font-size: 10px; margin-bottom: 2px; }
  .hist-outcome { font-size: 9px; font-weight: 700; }
  .outcome-bull { color: var(--call); }
  .outcome-bear { color: var(--put); }
  .outcome-trap { color: var(--neutral); }

  /* SETTINGS PANEL */
  #settings-panel {
    position: fixed;
    top: 0; right: -360px;
    width: 360px;
    height: 100vh;
    background: #080818;
    border-left: 1px solid var(--border2);
    z-index: 2000;
    padding: 16px;
    overflow-y: auto;
    transition: right 0.3s ease;
  }

  #settings-panel.open { right: 0; }

  .settings-title {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--purple);
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .settings-section {
    margin-bottom: 14px;
  }

  .settings-section-title {
    font-size: 10px;
    color: var(--text2);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }

  .settings-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    font-size: 11px;
  }

  .settings-lbl { color: var(--text2); }

  input[type="range"] {
    -webkit-appearance: none;
    width: 100px;
    height: 4px;
    background: var(--border2);
    border-radius: 2px;
    outline: none;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--purple);
    cursor: pointer;
  }

  .toggle {
    position: relative;
    width: 36px; height: 18px;
    background: var(--border2);
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .toggle.on { background: var(--purple); }

  .toggle::after {
    content: '';
    position: absolute;
    top: 2px; left: 2px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: white;
    transition: left 0.2s;
  }

  .toggle.on::after { left: 20px; }

  input[type="text"].tg-input {
    width: 100%;
    background: var(--bg2);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 6px 8px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    border-radius: 3px;
    margin-top: 4px;
  }

  /* ALERTS */
  #alerts-container {
    position: fixed;
    top: 60px; right: 12px;
    z-index: 3000;
    display: flex;
    flex-direction: column;
    gap: 6px;
    pointer-events: none;
  }

  .alert-toast {
    background: var(--card2);
    border: 1px solid var(--border2);
    border-left: 3px solid var(--purple);
    border-radius: 3px;
    padding: 8px 12px;
    font-size: 11px;
    max-width: 280px;
    animation: slideIn 0.3s ease;
    pointer-events: all;
    opacity: 1;
    transition: opacity 0.5s;
  }

  .alert-toast.fade { opacity: 0; }
  .alert-toast.call-alert { border-left-color: var(--call); }
  .alert-toast.put-alert { border-left-color: var(--put); }
  .alert-toast.warn-alert { border-left-color: var(--neutral); }

  @keyframes slideIn {
    from { transform: translateX(20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  .alert-title { font-weight: 700; margin-bottom: 2px; }
  .alert-body { color: var(--text2); font-size: 10px; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--purple); }

  /* LOADING STATE */
  .skeleton {
    background: linear-gradient(90deg, var(--border) 25%, var(--border2) 50%, var(--border) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 2px;
    height: 12px;
    margin: 4px 0;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  /* BOTTOM ROW */
  #bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    #main { grid-template-columns: 1fr 1fr; }
    #right-col { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 720px) {
    #main { grid-template-columns: 1fr; }
    #right-col { grid-template-columns: 1fr; }
  }

  /* MISC UTILS */
  .green { color: var(--call); }
  .red { color: var(--put); }
  .yellow { color: var(--neutral); }
  .purple { color: var(--purple); }
  .cyan { color: var(--cyan); }
  .blue { color: var(--blue); }
  .muted { color: var(--text2); }

  .mono { font-family: 'Space Mono', monospace; }
  .syne { font-family: 'Syne', sans-serif; }

  .section-spacer { height: 8px; }

  .error-badge {
    background: rgba(255,23,68,0.1);
    border: 1px solid rgba(255,23,68,0.3);
    color: var(--put);
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 2px;
    display: inline-block;
  }

  .stale-badge {
    background: rgba(255,214,0,0.1);
    border: 1px solid rgba(255,214,0,0.3);
    color: var(--neutral);
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 2px;
    display: inline-block;
  }

  /* WILLIAMS %R CHART */
  .williams-bar {
    width: 100%;
    height: 8px;
    background: var(--border2);
    border-radius: 4px;
    overflow: hidden;
    margin: 6px 0;
    position: relative;
  }

  .williams-zones {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: var(--text2);
  }

  .williams-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s;
  }

  /* WILLIAMS %R VALUE  */
  .wval {
    font-family: 'Syne', sans-serif;
    font-size: 24px;
    font-weight: 800;
    text-align: center;
    padding: 4px 0;
  }

  .wpattern {
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    margin-top: 4px;
    letter-spacing: 1px;
  }

  /* BIG PLAYERS */
  .bp-bar {
    height: 16px;
    border-radius: 3px;
    display: flex;
    overflow: hidden;
    margin: 6px 0;
  }

  .bp-buy { background: rgba(0,230,118,0.6); transition: width 0.8s; }
  .bp-sell { background: rgba(255,23,68,0.6); transition: width 0.8s; }
  .bp-labels { display: flex; justify-content: space-between; font-size: 11px; }

  /* SEPARATOR LINE */
  .sep { border: none; border-top: 1px solid var(--border); margin: 8px 0; }

  /* RISK MATRIX */
  .risk-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }
  .risk-row:last-child { border-bottom: none; }
  .risk-factor { color: var(--text2); font-size: 10px; }

  .risk-state {
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 2px;
    border: 1px solid;
  }

  .risk-bull { color: var(--call); border-color: rgba(0,230,118,0.3); background: rgba(0,230,118,0.06); }
  .risk-bear { color: var(--put); border-color: rgba(255,23,68,0.3); background: rgba(255,23,68,0.06); }
  .risk-neut { color: var(--text2); border-color: var(--border); background: var(--bg2); }
  .risk-warn { color: var(--neutral); border-color: rgba(255,214,0,0.3); background: rgba(255,214,0,0.06); }
  .risk-high { color: var(--put); border-color: rgba(255,23,68,0.5); background: rgba(255,23,68,0.1); }

  /* CONFIDENCE DECAY */
  .decay-bar {
    width: 100%;
    height: 4px;
    background: var(--border2);
    border-radius: 2px;
    overflow: hidden;
    margin: 4px 0;
  }
  .decay-fill { height: 100%; background: linear-gradient(90deg, var(--call), var(--neutral), var(--put)); border-radius: 2px; transition: width 1s; }

  /* TELEGRAM PANEL */
  .tg-log {
    font-size: 10px;
    color: var(--text2);
    line-height: 1.6;
    max-height: 80px;
    overflow-y: auto;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 6px 8px;
  }

  /* MARKET REGIME */
  .regime-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 3px;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    border: 1px solid;
    margin-bottom: 6px;
  }

  .regime-TRENDING { color: var(--expansion); border-color: var(--expansion); background: rgba(105,240,174,0.08); }
  .regime-RANGING { color: var(--blue); border-color: var(--blue); background: rgba(100,181,246,0.08); }
  .regime-COMPRESSION { color: var(--purple); border-color: var(--purple); background: rgba(206,147,216,0.08); }
  .regime-EXPANSION { color: var(--call); border-color: var(--call); background: rgba(0,230,118,0.08); }
  .regime-DISTRIBUTION { color: var(--distribution); border-color: var(--distribution); background: rgba(255,138,101,0.08); }
  .regime-ACCUMULATION { color: var(--accumulation); border-color: var(--accumulation); background: rgba(100,181,246,0.08); }
  .regime-MANIPULATION { color: var(--manipulation); border-color: var(--manipulation); background: rgba(206,147,216,0.1); }
</style>
</head>
