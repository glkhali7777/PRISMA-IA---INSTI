function drawCVDChart() {
  const canvas = document.getElementById('cvd-canvas');
  const ctx = canvas.getContext('2d');
  const w = canvas.offsetWidth || 200, h = 70;
  canvas.width = w; canvas.height = h;
  ctx.clearRect(0, 0, w, h);

  if (cvdHistory.length < 2) return;

  const min = Math.min(...cvdHistory), max = Math.max(...cvdHistory);
  const range = max - min || 1;

  const gradient = ctx.createLinearGradient(0, 0, 0, h);
  const lastVal = cvdHistory[cvdHistory.length - 1];
  const color = lastVal >= 0 ? '#00e676' : '#ff1744';
  gradient.addColorStop(0, color + '40');
  gradient.addColorStop(1, color + '00');

  ctx.beginPath();
  cvdHistory.forEach((v, i) => {
    const x = (i / (cvdHistory.length - 1)) * w;
    const y = h - ((v - min) / range) * (h - 8) - 4;
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  });

  const lastX = w;
  const lastY = h - ((lastVal - min) / range) * (h - 8) - 4;
  ctx.lineTo(lastX, h);
  ctx.lineTo(0, h);
  ctx.closePath();
  ctx.fillStyle = gradient;
  ctx.fill();

  ctx.beginPath();
  cvdHistory.forEach((v, i) => {
    const x = (i / (cvdHistory.length - 1)) * w;
    const y = h - ((v - min) / range) * (h - 8) - 4;
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  });
  ctx.strokeStyle = color;
  ctx.lineWidth = 1.5;
  ctx.stroke();

  // Zero line
  const zeroY = h - ((0 - min) / range) * (h - 8) - 4;
  ctx.beginPath();
  ctx.moveTo(0, zeroY); ctx.lineTo(w, zeroY);
  ctx.strokeStyle = '#ffffff20'; ctx.lineWidth = 1; ctx.stroke();
}

