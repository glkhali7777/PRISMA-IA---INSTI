// SCENARIO PROJECTION ENGINE
// ============================================================

function projectScenarios(candles, smc, zones, delivery, signal) {
  if (candles.length < 20) return {};
  const price = candles[candles.length - 1].close;
  const atr = calcATR(candles, 14);

  const bullProb = signal.dir === 'CALL' ? signal.confidence : signal.dir === 'PUT' ? 100 - signal.confidence : 45;
  const bearProb = signal.dir === 'PUT' ? signal.confidence : signal.dir === 'CALL' ? 100 - signal.confidence : 35;
  const neutProb = 100 - bullProb - bearProb;

  const bslTarget = smc.bsl || price + atr * 3;
  const sslTarget = smc.ssl || price - atr * 3;

  return {
    bullish: {
      prob: Math.min(95, Math.max(5, bullProb)),
      target1: price + atr * 1.5,
      target2: bslTarget,
      confirmation: price + atr * 0.5,
      invalidation: price - atr * 1.5,
      narr: lang === 'pt'
        ? `Se aceitar acima de ${fmtPrice(price + atr * 0.5)} → expansão até ${fmtPrice(bslTarget)}.`
        : `If accepts above ${fmtPrice(price + atr * 0.5)} → expansion to ${fmtPrice(bslTarget)}.`
    },
    bearish: {
      prob: Math.min(95, Math.max(5, bearProb)),
      target1: price - atr * 1.5,
      target2: sslTarget,
      confirmation: price - atr * 0.5,
      invalidation: price + atr * 1.5,
      narr: lang === 'pt'
        ? `Se rejeitar em ${fmtPrice(price - atr * 0.5)} → queda até ${fmtPrice(sslTarget)}.`
        : `If rejects at ${fmtPrice(price - atr * 0.5)} → drop to ${fmtPrice(sslTarget)}.`
    },
    neutral: {
      prob: Math.max(0, Math.min(50, 100 - bullProb - bearProb + 10)),
      narr: lang === 'pt'
        ? `Consolidação entre ${fmtPrice(price - atr)} e ${fmtPrice(price + atr)}.`
        : `Consolidation between ${fmtPrice(price - atr)} and ${fmtPrice(price + atr)}.`
    },
    keyLevel: price + (signal.dir === 'CALL' ? atr * 0.5 : -atr * 0.5)
  };
}

// ============================================================
// FORMAT HELPERS
// ============================================================

function fmtPrice(p) {
  if (!p || isNaN(p)) return '--';
  if (p > 1000) return p.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  if (p > 1) return p.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
  return p.toFixed(8);
}

function fmtUSD(v) {
  if (v >= 1e9) return '$' + (v/1e9).toFixed(1) + 'B';
  if (v >= 1e6) return '$' + (v/1e6).toFixed(1) + 'M';
  if (v >= 1e3) return '$' + (v/1e3).toFixed(0) + 'K';
  return '$' + v.toFixed(0);
}

function timeAgo(ts) {
  const d = (Date.now() - ts) / 1000;
  if (d < 60) return Math.round(d) + 's';
  if (d < 3600) return Math.round(d/60) + 'm';
  return Math.round(d/3600) + 'h';
}

