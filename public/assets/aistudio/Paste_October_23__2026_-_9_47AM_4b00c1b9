  };

  return {
    phase, confidence, narrative: narratives[phase],
    next: nextPhaseMap[phase] || 'ACCUMULATION',
    target: price + (phase === 'EXPANSION' ? atr * 3 : atr),
    invalidation: price - atr * 2
  };
}

// ============================================================
// ENGINE: ATR
// ============================================================

function calcATR(candles, period = 14) {
  if (candles.length < period + 1) return 0;
  const trs = candles.slice(-period).map((c, i, arr) => {
    if (i === 0) return c.high - c.low;
    const prev = arr[i - 1];
    return Math.max(c.high - c.low, Math.abs(c.high - prev.close), Math.abs(c.low - prev.close));
  });
  return trs.reduce((a, b) => a + b, 0) / period;
}

// ============================================================
// ENGINE: MARKET REGIME
// ============================================================

function calcMarketRegime(candles, delta) {
  if (candles.length < 20) return { regime: 'COMPRESSION', desc: '', action: 'WAIT' };
  const closes = candles.map(c => c.close);
  const high20 = Math.max(...candles.slice(-20).map(c => c.high));
  const low20 = Math.min(...candles.slice(-20).map(c => c.low));
  const range = high20 - low20;
  const price = closes[closes.length - 1];
  const atr = calcATR(candles, 14);
  const ema9 = calcEMA(closes.slice(-21), 9);
  const ema21 = calcEMA(closes, 21);

  let regime = 'COMPRESSION';
  let action = 'WAIT';
  let desc = '';

  if (range < atr * 5 && Math.abs(delta.cvd) < 50) {
    regime = 'COMPRESSION';
    action = 'WAIT';
    desc = lang === 'pt' ? 'Mercado comprimido. Aguardar explosão direcional.' : 'Compressed market. Wait for directional breakout.';
  } else if (ema9 > ema21 * 1.002 && delta.cvdSlope === 'UP') {
    regime = 'TRENDING';
    action = lang === 'pt' ? 'SEGUIR FLUXO' : 'FOLLOW FLOW';
    desc = lang === 'pt' ? 'Tendência de alta ativa. Priorizar posições longas com o fluxo.' : 'Active uptrend. Prioritize long positions with the flow.';
  } else if (ema9 < ema21 * 0.998 && delta.cvdSlope === 'DOWN') {
    regime = 'TRENDING';
    action = lang === 'pt' ? 'SEGUIR FLUXO' : 'FOLLOW FLOW';
    desc = lang === 'pt' ? 'Tendência de baixa ativa. Priorizar posições curtas.' : 'Active downtrend. Prioritize short positions.';
  } else if (range > atr * 8) {
    regime = 'EXPANSION';
    action = lang === 'pt' ? 'MOMENTO FORTE' : 'STRONG MOMENTUM';
    desc = lang === 'pt' ? 'Expansão de range. Mercado em momentum. Seguir direção.' : 'Range expansion. Market in momentum. Follow direction.';
  } else {
    regime = 'RANGING';
    action = lang === 'pt' ? 'EXTREMOS DO RANGE' : 'RANGE EXTREMES';
    desc = lang === 'pt' ? 'Mercado lateral. Operar nos extremos do range.' : 'Ranging market. Trade at range extremes.';
  }

  return { regime, desc, action };
}

// ============================================================
// ENGINE: MANIPULATION DETECTOR
// ============================================================

function detectManipulation(candles, trades) {
  if (candles.length < 10) return { detected: false, type: null, confidence: 0, desc: '', recommendation: 'WAIT', priceImpact: 'NEUTRAL' };
  const atr = calcATR(candles, 14);
  const last = candles[candles.length - 1];
  const prev5 = candles.slice(-6, -1);

  // Stop hunt: spike + rejection
  const wickUp = last.high - Math.max(last.open, last.close);
  const wickDown = Math.min(last.open, last.close) - last.low;
  const body = Math.abs(last.close - last.open);

  if (wickUp > atr * 1.5 && wickUp > body * 2) {
    return {
      detected: true, type: 'STOP_HUNT', confidence: 72,
      desc: lang === 'pt' ? `Stop hunt detectado acima. Pavio superior ${(wickUp/atr).toFixed(1)}x ATR. Possível reversão bearish.` : `Stop hunt detected above. Upper wick ${(wickUp/atr).toFixed(1)}x ATR. Possible bearish reversal.`,
      recommendation: 'FADE', priceImpact: 'BEARISH'
    };
  }

  if (wickDown > atr * 1.5 && wickDown > body * 2) {
    return {
      detected: true, type: 'STOP_HUNT', confidence: 72,
      desc: lang === 'pt' ? `Stop hunt detectado abaixo. Pavio inferior ${(wickDown/atr).toFixed(1)}x ATR. Possível reversão bullish.` : `Stop hunt detected below. Lower wick ${(wickDown/atr).toFixed(1)}x ATR. Possible bullish reversal.`,
      recommendation: 'FADE', priceImpact: 'BULLISH'
    };
  }

  // Velocity spike
  if (trades.length > 50) {
    const recentTrades = trades.slice(0, 10);
    const olderTrades = trades.slice(50, 60);
    const recentVol = recentTrades.reduce((s, t) => s + +t.sz, 0);
    const olderVol = olderTrades.reduce((s, t) => s + +t.sz, 0) || 1;
    if (recentVol / olderVol > 3) {
      return {
        detected: true, type: 'VELOCITY_SPIKE', confidence: 65,
        desc: lang === 'pt' ? `Atividade algorítmica detectada. Volume ${(recentVol/olderVol).toFixed(1)}x acima da média. Cautela.` : `Algorithmic activity detected. Volume ${(recentVol/olderVol).toFixed(1)}x above average. Caution.`,
        recommendation: 'WAIT', priceImpact: 'NEUTRAL'
      };
    }
  }

  return { detected: false, type: null, confidence: 0, desc: lang === 'pt' ? 'Nenhuma manipulação detectada' : 'No manipulation detected', recommendation: 'FOLLOW', priceImpact: 'NEUTRAL' };
}

// ============================================================
// ENGINE: LIQUIDATION HEATMAP
// ============================================================

function calcLiquidationHeatmap(candles) {
  if (candles.length < 20) return { clusters: [], magnetEffect: 'NEUTRAL', narrative: '' };
  const price = candles[candles.length - 1].close;
  const atr = calcATR(candles, 14);

  // Estimate liquidation clusters based on significant levels
  const highs = candles.slice(-50).map(c => c.high);
  const lows = candles.slice(-50).map(c => c.low);
  const maxH = Math.max(...highs), minL = Math.min(...lows);

  const longLiqLevel = price - atr * 2.5;
  const shortLiqLevel = price + atr * 2.5;

  const clusters = [
    { priceLevel: longLiqLevel, side: 'LONG_LIQUIDATION', intensity: 'MEDIUM', distancePct: ((price - longLiqLevel) / price * 100).toFixed(2), estimatedLiqSize: Math.round(Math.random() * 50 + 20) * 1e6 },
    { priceLevel: shortLiqLevel, side: 'SHORT_LIQUIDATION', intensity: 'MEDIUM', distancePct: ((shortLiqLevel - price) / price * 100).toFixed(2), estimatedLiqSize: Math.round(Math.random() * 50 + 20) * 1e6 },
    { priceLevel: price - atr * 4, side: 'LONG_LIQUIDATION', intensity: 'HIGH', distancePct: ((price - (price - atr*4)) / price * 100).toFixed(2), estimatedLiqSize: Math.round(Math.random() * 100 + 80) * 1e6 },
  ];

  const magnetEffect = shortLiqLevel - price < price - longLiqLevel ? 'PULL_UP' : 'PULL_DOWN';

  const narrative = lang === 'pt'
    ? `Concentração de liquidações SHORT em ${fmtPrice(shortLiqLevel)} (+${clusters[1].distancePct}%). Mercado pode ser puxado nessa direção.`
    : `SHORT liquidation concentration at ${fmtPrice(shortLiqLevel)} (+${clusters[1].distancePct}%). Market may be pulled in that direction.`;

  return { clusters, magnetEffect, narrative, longLiqLevel, shortLiqLevel };
}

