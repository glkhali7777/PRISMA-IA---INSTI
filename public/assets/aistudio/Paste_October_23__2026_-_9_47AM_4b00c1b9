function calcHistoricalSimilarity(candles, delta, funding, smc) {
  if (candles.length < 20) return { matches: [], probabilities: { bull: 40, bear: 30, rev: 20, trap: 10 } };

  const closes = candles.map(c => c.close);
  const ema9 = calcEMA(closes.slice(-21), 9);
  const ema21 = calcEMA(closes, 21);

  const currentCtx = {
    structure: ema9 > ema21 ? 'BULLISH' : 'BEARISH',
    deltaPattern: delta.cvdSlope === 'UP' ? 'POSITIVE' : delta.cvdSlope === 'DOWN' ? 'NEGATIVE' : 'DIVERGENT',
    fundingExtremes: funding && (Math.abs(+funding.fundingRate) > 0.001),
    oiProfile: 'GROWING',
    sweepBeforeMove: smc.sweepDetected,
    compressionBeforeExpansion: false,
  };

  const matches = HISTORICAL_DB.map(snap => {
    let score = 0;
    if (currentCtx.structure === snap.context.structure) score += 20;
    if (currentCtx.deltaPattern === snap.context.deltaPattern) score += 20;
    if (currentCtx.fundingExtremes === snap.context.fundingExtremes) score += 15;
    if (currentCtx.sweepBeforeMove === snap.context.sweepBeforeMove) score += 25;
    if (currentCtx.compressionBeforeExpansion === snap.context.compressionBeforeExpansion) score += 20;
    return { ...snap, similarity: score, matchedFactors: [] };
  }).sort((a, b) => b.similarity - a.similarity).slice(0, 3);

  const outcomes = matches.map(m => m.outcome);
  const bullCount = outcomes.filter(o => o === 'BULLISH_CONTINUATION').length;
  const bearCount = outcomes.filter(o => o === 'BEARISH_CONTINUATION').length;
  const trapCount = outcomes.filter(o => o === 'BULL_TRAP' || o === 'BEAR_TRAP').length;
  const revCount = outcomes.filter(o => o === 'REVERSAL').length;
  const total = matches.length || 1;

  return {
    matches,
    probabilities: {
      bull: Math.round(bullCount / total * 100),
      bear: Math.round(bearCount / total * 100),
      rev: Math.round(revCount / total * 100),
      trap: Math.round(trapCount / total * 100)
    }
  };
}

// ============================================================
// ENGINE: WHALE TRACKER (from OKX large trades)
// ============================================================

function calcWhaleActivity(trades, price) {
  if (!trades || trades.length === 0) return { events: [], netFlow: 0, domSignal: 'NEUTRAL', accScore: 50, distScore: 50 };
  const totalVol = trades.reduce((s, t) => s + +t.sz, 0);
  const avgVol = totalVol / trades.length;

  // Detect large trades
  const largeTrades = trades.filter(t => +t.sz > avgVol * 5);
  const buyLarge = largeTrades.filter(t => t.side === 'buy');
  const sellLarge = largeTrades.filter(t => t.side === 'sell');

  const events = largeTrades.slice(0, 5).map(t => ({
    amount: +t.sz,
    amountUsd: +t.sz * price,
    type: t.side === 'buy' ? 'EXCHANGE_INFLOW' : 'EXCHANGE_OUTFLOW',
    fromLabel: null, toLabel: null,
    timestamp: +t.ts,
    impact: t.side === 'buy' ? 'BULLISH' : 'BEARISH',
    reason: t.side === 'buy' ?
      (lang === 'pt' ? `Compra institucional: ${(+t.sz * price / 1e6).toFixed(2)}M USD` : `Institutional buy: ${(+t.sz * price / 1e6).toFixed(2)}M USD`) :
      (lang === 'pt' ? `Venda institucional: ${(+t.sz * price / 1e6).toFixed(2)}M USD` : `Institutional sell: ${(+t.sz * price / 1e6).toFixed(2)}M USD`)
  }));

  const netFlow = buyLarge.reduce((s,t)=>s+(+t.sz),0) - sellLarge.reduce((s,t)=>s+(+t.sz),0);
  const domSignal = netFlow > 0 ? 'ACCUMULATING' : netFlow < 0 ? 'DISTRIBUTING' : 'NEUTRAL';

  return { events, netFlow, domSignal, accScore: netFlow > 0 ? 70 : 30, distScore: netFlow < 0 ? 70 : 30 };
}

// ============================================================
// ENGINE: NEWS IMPACT
// ============================================================

function classifyNews(newsItems) {
  const BULLISH_KW = ['etf', 'approval', 'halving', 'adoption', 'buy', 'bullish', 'upgrade', 'institutional', 'inflow', 'rate cut', 'partnership'];
  const BEARISH_KW = ['hack', 'ban', 'jail', 'seized', 'crash', 'dump', 'sell', 'inflation', 'rate hike', 'war', 'recession', 'liquidation', 'sec', 'regulation'];
  const EXTREME_KW = ['ban', 'crash', 'hack', 'etf approval', 'halving', 'rate cut', 'war'];

  return newsItems.slice(0, 8).map(n => {
    const title = (n.title || '').toLowerCase();
    const body = (n.body || '').toLowerCase();
    const text = title + ' ' + body;

    let impact = 'LOW', direction = 'NEUTRAL', modifier = 0;
    const bullScore = BULLISH_KW.filter(k => text.includes(k)).length;
    const bearScore = BEARISH_KW.filter(k => text.includes(k)).length;
    const isExtreme = EXTREME_KW.some(k => text.includes(k));

    if (bullScore > bearScore) { direction = 'BULLISH'; modifier = bullScore * 3; }
    else if (bearScore > bullScore) { direction = 'BEARISH'; modifier = -(bearScore * 3); }

    if (isExtreme) impact = 'EXTREME';
    else if (bullScore + bearScore > 2) impact = 'HIGH';
    else if (bullScore + bearScore > 0) impact = 'MEDIUM';

    return {
      title: n.title || '',
      source: n.source_info?.name || n.source || 'CryptoCompare',
      impact, direction, confidenceModifier: Math.max(-30, Math.min(15, modifier)),
      timestamp: n.published_on * 1000 || Date.now(),
      category: 'CRYPTO'
    };
  });
}

