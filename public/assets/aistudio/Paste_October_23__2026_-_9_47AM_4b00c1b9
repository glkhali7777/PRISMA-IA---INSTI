// ============================================================
// ENGINE: SIGNAL AGGREGATOR
// ============================================================

function aggregateSignal({ htf, williams, orderBlocks, zones, delta, smc, delivery, execution, manip, funding, historical, candles }) {
  let callVotes = 0, putVotes = 0;
  const price = candles[candles.length - 1].close;
  const atr = calcATR(candles, 14);
  const reasons = [];

  // Williams %R
  if (williams.signal === 'CALL') { callVotes += williams.confidence / 20; reasons.push(`✅ Williams: ${williams.pattern} — CALL ${williams.confidence}%`); }
  else if (williams.signal === 'PUT') { putVotes += williams.confidence / 20; reasons.push(`✅ Williams: ${williams.pattern} — PUT ${williams.confidence}%`); }

  // Order blocks
  const nearOBs = orderBlocks.filter(ob => Math.abs(ob.top + ob.bottom) / 2 - price < atr * 2);
  nearOBs.forEach(ob => {
    if (ob.type === 'BULL') { callVotes += 3; reasons.push(`🟢 OB BULL próximo: ${fmtPrice(ob.bottom)}-${fmtPrice(ob.top)}`); }
    else { putVotes += 3; reasons.push(`🔴 OB BEAR próximo: ${fmtPrice(ob.bottom)}-${fmtPrice(ob.top)}`); }
  });

  // Liquidity zones
  if (zones.green.length > 0 && zones.green[0].mid < price && zones.green[0].strength > 50) {
    callVotes += 2; reasons.push(`🟢 Suporte institucional em ${fmtPrice(zones.green[0].mid)}`);
  }
  if (zones.red.length > 0 && zones.red[0].mid > price && zones.red[0].strength > 50) {
    putVotes += 2; reasons.push(`🔴 Resistência institucional em ${fmtPrice(zones.red[0].mid)}`);
  }

  // Delta / CVD
  if (delta.cvdSlope === 'UP') { callVotes += 3; reasons.push(`✅ CVD ascendente — compradores dominando`); }
  else if (delta.cvdSlope === 'DOWN') { putVotes += 3; reasons.push(`🔴 CVD descendente — vendedores dominando`); }

  // Big Players
  const buyPct = delta.buyVol / (delta.buyVol + delta.sellVol + 0.001) * 100;
  if (buyPct > 60) { callVotes += 2; reasons.push(`🟢 Big Players comprando: ${buyPct.toFixed(0)}%`); }
  else if (buyPct < 40) { putVotes += 2; reasons.push(`🔴 Big Players vendendo: ${(100-buyPct).toFixed(0)}%`); }

  // SMC
  if (smc.sweepDetected) {
    if (smc.sweepDir === 'SSL_SWEPT') { callVotes += 4; reasons.push(`⚡ SSL Swept — sweep bullish detectado`); }
    else { putVotes += 4; reasons.push(`⚡ BSL Swept — sweep bearish detectado`); }
  }
  if (smc.bos) { callVotes += 3; reasons.push(`✅ BOS Bullish — quebra de estrutura confirmada`); }
  if (smc.choch) { callVotes += 4; reasons.push(`🔄 CHoCH detectado — mudança de caráter`); }

  // Delivery model
  if (delivery.phase === 'EXPANSION') { callVotes += 3; reasons.push(`🚀 Fase EXPANSÃO — momentum institucional`); }
  else if (delivery.phase === 'DISTRIBUTION') { putVotes += 3; reasons.push(`⚠️ Fase DISTRIBUIÇÃO — risco de reversão`); }
  else if (delivery.phase === 'MANIPULATION') { callVotes -= 1; putVotes -= 1; reasons.push(`⚠️ Fase MANIPULAÇÃO — aguardar confirmação`); }

  // FVG
  const activeFVGs = (smc.fvgs || []).filter(f => !f.mitigated);
  activeFVGs.forEach(fvg => {
    if (fvg.type === 'BULLISH') { callVotes += 1.5; reasons.push(`🔵 FVG Bullish não mitigado`); }
    else { putVotes += 1.5; reasons.push(`🔵 FVG Bearish não mitigado`); }
  });

  // 3 Last candles
  const last3 = candles.slice(-4, -1);
  const bullCandles = last3.filter(c => c.close > c.open).length;
  const bearCandles = last3.filter(c => c.close < c.open).length;
  if (bullCandles >= 2) { callVotes += 2; reasons.push(`📈 ${bullCandles}/3 velas fechadas de alta`); }
  else if (bearCandles >= 2) { putVotes += 2; reasons.push(`📉 ${bearCandles}/3 velas fechadas de baixa`); }

  // Funding extreme
  if (funding) {
    const fr = +funding.fundingRate;
    if (fr > 0.001) { putVotes += 2; reasons.push(`⚠️ Funding extremo positivo — risco long squeeze`); }
    else if (fr < -0.001) { callVotes += 2; reasons.push(`✅ Funding extremo negativo — possível short squeeze`); }
  }

  // Manipulation penalty
  if (manip.detected) { callVotes -= 1; putVotes -= 1; reasons.push(`⚠️ Manipulação detectada: ${manip.type}`); }

  // HTF BONUS / BLOCK
  let htfBlocked = false, htfBonus = 0;
  const total = callVotes + putVotes;

  let dir = 'NEUTRAL';
  let baseConf = 50;

  if (total < 3) { dir = 'AGUARDAR'; baseConf = 30; }
  else if (callVotes > putVotes * 1.2) {
    if (htf.aligned === 'BEARISH') { htfBlocked = true; dir = 'AGUARDAR'; baseConf = 35; }
    else { dir = 'CALL'; baseConf = 50 + callVotes * 5; if (htf.aligned === 'BULLISH') { htfBonus = 8; reasons.push(`✅ HTF alinhado BULLISH — bônus +8%`); } }
  } else if (putVotes > callVotes * 1.2) {
    if (htf.aligned === 'BULLISH') { htfBlocked = true; dir = 'AGUARDAR'; baseConf = 35; }
    else { dir = 'PUT'; baseConf = 50 + putVotes * 5; if (htf.aligned === 'BEARISH') { htfBonus = 8; reasons.push(`✅ HTF alinhado BEARISH — bônus +8%`); } }
  } else { dir = 'AGUARDAR'; baseConf = 40; }

  const confidence = Math.min(98, Math.round(baseConf + htfBonus));

  // TP/SL
  const entry = price;
  const sl = dir === 'CALL' ? price - atr * 1.5 : dir === 'PUT' ? price + atr * 1.5 : price;
  const tp1 = dir === 'CALL' ? price + atr * 1.5 : dir === 'PUT' ? price - atr * 1.5 : price;
  const tp2 = dir === 'CALL' ? price + atr * 3 : dir === 'PUT' ? price - atr * 3 : price;
  const tp3 = dir === 'CALL' ? price + atr * 4.5 : dir === 'PUT' ? price - atr * 4.5 : price;

  return { dir, confidence, callVotes, putVotes, reasons, entry, sl, tp1, tp2, tp3, htfBlocked, htfBonus };
}

