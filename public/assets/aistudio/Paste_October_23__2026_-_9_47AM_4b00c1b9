// ENGINE: EXECUTION TIMING
// ============================================================

function calcExecutionTiming(candles, delivery, smc, delta) {
  if (candles.length < 10) return { quality: 'WAIT', reason: '', aggressive: 0, conservative: 0 };
  const price = candles[candles.length - 1].close;
  const atr = calcATR(candles, 14);

  let quality = 'WAIT';
  let reason = '';

  if (delivery.phase === 'EXPANSION' && delta.cvdSlope === 'UP') {
    quality = 'OPTIMAL';
    reason = lang === 'pt' ? 'Expansão + CVD bullish. Micro pullback confirmado.' : 'Expansion + bullish CVD. Micro pullback confirmed.';
  } else if (smc.sweepDetected && delta.cvdSlope === 'UP') {
    quality = 'OPTIMAL';
    reason = lang === 'pt' ? 'Sweep + absorção compradora. Entrada de alta qualidade.' : 'Sweep + buying absorption. High quality entry.';
  } else if (delivery.phase === 'ACCUMULATION') {
    quality = 'GOOD';
    reason = lang === 'pt' ? 'Acumulação. Aguardar confirmação de ruptura.' : 'Accumulation. Wait for breakout confirmation.';
  } else if (delivery.phase === 'MANIPULATION') {
    quality = 'WAIT';
    reason = lang === 'pt' ? 'Manipulação ativa. Aguardar absorção confirmar.' : 'Active manipulation. Wait for absorption confirmation.';
  } else if (delivery.phase === 'DISTRIBUTION') {
    quality = 'AVOID';
    reason = lang === 'pt' ? 'Distribuição. Alto risco. Evitar entradas longas.' : 'Distribution. High risk. Avoid long entries.';
  }

  return { quality, reason, aggressive: price, conservative: price - atr * 0.3 };
}

