function buildNarrative(price, htf, smc, delivery, delta, zones, signal, williams, funding, hist) {
  const fmtP = fmtPrice;
  const bullish = lang === 'pt';

  let n = '';

  // Context
  if (smc.sweepDetected) {
    n += smc.sweepDir === 'SSL_SWEPT'
      ? (bullish ? `${currentInst.split('-')[0]} realizou sweep abaixo dos fundos, capturando sell-side liquidity em ${fmtP(smc.ssl)}.\n` : `${currentInst.split('-')[0]} swept below lows, capturing sell-side liquidity at ${fmtP(smc.ssl)}.\n`)
      : (bullish ? `${currentInst.split('-')[0]} realizou sweep acima dos topos, capturando buy-side liquidity em ${fmtP(smc.bsl)}.\n` : `${currentInst.split('-')[0]} swept above highs, capturing buy-side liquidity at ${fmtP(smc.bsl)}.\n`);
  }

  // Delta
  if (delta.cvdSlope === 'UP') {
    n += bullish ? `CVD ascendente com delta comprador forte (${delta.deltaStrength}%). Absorção compradora confirmada.\n` : `Ascending CVD with strong buying delta (${delta.deltaStrength}%). Buying absorption confirmed.\n`;
  } else if (delta.cvdSlope === 'DOWN') {
    n += bullish ? `CVD descendente com pressão vendedora dominante (${delta.deltaStrength}%). Vendedores agressivos.\n` : `Descending CVD with dominant selling pressure (${delta.deltaStrength}%). Aggressive sellers.\n`;
  }

  // Delivery phase
  n += bullish ? `Fase atual: ${delivery.phase}. ${delivery.narrative}\n` : `Current phase: ${delivery.phase}. ${delivery.narrative}\n`;

  // Liquidity targets
  if (smc.bsl) n += bullish ? `Liquidez buy-side resting acima de ${fmtP(smc.bsl)}. Provável alvo institucional.\n` : `Buy-side liquidity resting above ${fmtP(smc.bsl)}. Likely institutional target.\n`;
  if (smc.ssl) n += bullish ? `Liquidez sell-side resting abaixo de ${fmtP(smc.ssl)}. Risco de sweep.\n` : `Sell-side liquidity resting below ${fmtP(smc.ssl)}. Sweep risk.\n`;

  // FVGs
  const openFVGs = (smc.fvgs || []).filter(f => !f.mitigated);
  if (openFVGs.length > 0) {
    const fvg = openFVGs[0];
    n += bullish ? `FVG ${fvg.type} aberto entre ${fmtP(fvg.bottom)} - ${fmtP(fvg.top)}. Desequilíbrio institucional não mitigado.\n` : `Open ${fvg.type} FVG between ${fmtP(fvg.bottom)} - ${fmtP(fvg.top)}. Unmitigated institutional imbalance.\n`;
  }

  // Funding
  if (funding) {
    const fr = +funding.fundingRate;
    if (Math.abs(fr) > 0.001) {
      n += bullish
        ? `Funding ${fr > 0 ? 'extremamente positivo' : 'extremamente negativo'} (${(fr * 100).toFixed(4)}%). ${fr > 0 ? 'Risco de long squeeze aumentando.' : 'Possível short squeeze.'}\n`
        : `Funding ${fr > 0 ? 'extremely positive' : 'extremely negative'} (${(fr * 100).toFixed(4)}%). ${fr > 0 ? 'Long squeeze risk increasing.' : 'Possible short squeeze.'}\n`;
    }
  }

  // Signal conclusion
  if (signal.dir === 'CALL') {
    n += bullish
      ? `\nCONCLUSÃO: Confluência bullish forte (${signal.confidence}%). Entrada em ${fmtP(signal.entry)}, SL ${fmtP(signal.sl)}, TP ${fmtP(signal.tp1)}.\nConfirmação: fechamento acima de ${fmtP(signal.entry + calcATR(candles, 14) * 0.5)}.\nInvalidação: perda de ${fmtP(signal.sl)}.`
      : `\nCONCLUSION: Strong bullish confluence (${signal.confidence}%). Entry at ${fmtP(signal.entry)}, SL ${fmtP(signal.sl)}, TP ${fmtP(signal.tp1)}.\nConfirmation: close above ${fmtP(signal.entry + calcATR(candles, 14) * 0.5)}.\nInvalidation: loss of ${fmtP(signal.sl)}.`;
  } else if (signal.dir === 'PUT') {
    n += bullish
      ? `\nCONCLUSÃO: Confluência bearish forte (${signal.confidence}%). Entrada em ${fmtP(signal.entry)}, SL ${fmtP(signal.sl)}, TP ${fmtP(signal.tp1)}.\nConfirmação: fechamento abaixo de ${fmtP(signal.entry - calcATR(candles, 14) * 0.5)}.\nInvalidação: recuperação acima de ${fmtP(signal.sl)}.`
      : `\nCONCLUSION: Strong bearish confluence (${signal.confidence}%). Entry at ${fmtP(signal.entry)}, SL ${fmtP(signal.sl)}, TP ${fmtP(signal.tp1)}.\nConfirmation: close below ${fmtP(signal.entry - calcATR(candles, 14) * 0.5)}.\nInvalidation: recovery above ${fmtP(signal.sl)}.`;
  } else {
    n += bullish
      ? `\nAGUARDAR: Confluência insuficiente. Monitorar próximos candles para confirmação direcional.`
      : `\nWAIT: Insufficient confluence. Monitor next candles for directional confirmation.`;
  }

  return n;
}

