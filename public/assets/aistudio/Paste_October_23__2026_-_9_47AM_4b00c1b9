// ============================================================

function toggleSettings() {
  document.getElementById('settings-panel').classList.toggle('open');
}

// ============================================================
// MAIN REFRESH LOOP
// ============================================================

async function refresh() {
  const dot = document.getElementById('status-dot');
  dot.classList.add('loading');

  try {
    currentInst = document.getElementById('asset-select').value;
    currentBar = document.getElementById('tf-select').value;

    // Parallel data fetch
    const [cs, h4, h1, trd, fund, oi] = await Promise.all([
      fetchCandles(currentInst, currentBar, 300),
      fetchCandles(currentInst, '4H', 50),
      fetchCandles(currentInst, '1H', 50),
      fetchTrades(currentInst, 100),
      fetchFundingRate(currentInst),
      fetchOpenInterest(currentInst),
    ]);

    candles = cs; h4Candles = h4; h1Candles = h1; trades = trd;
    fundingData = fund; oiData = oi;

    if (cs.length < 5) {
      showAlert(lang==='pt'?'Sem dados':'No data', lang==='pt'?'Não foi possível buscar candles.':'Could not fetch candles.', 'warn-alert');
      dot.classList.remove('loading');
      return;
    }

    const price = cs[cs.length - 1].close;

    // Run all engines in parallel
    const htf = calcHTFBias(h4, h1);
    const williams = calcWilliamsR(cs);
    const orderBlocks = calcOrderBlocks(cs);
    const zones = calcLiquidityZones(cs);
    const delta = calcDeltaFlow(trd);
    const smc = calcSMC(cs);
    const delivery = calcDeliveryModel(cs, delta, oi, fund);
    const manip = detectManipulation(cs, trd);
    const regime = calcMarketRegime(cs, delta);
    const execTiming = calcExecutionTiming(cs, delivery, smc, delta);
    const liquidHeat = calcLiquidationHeatmap(cs);
    const corr = calcCorrelations(cs);
    const whale = calcWhaleActivity(trd, price);
    const hist = calcHistoricalSimilarity(cs, delta, fund, smc);
    const signal = aggregateSignal({ htf, williams, orderBlocks, zones, delta, smc, delivery, execution: execTiming, manip, funding: fund, historical: hist, candles: cs });
    const scenarios = projectScenarios(cs, smc, zones, delivery, signal);
    const narrative = buildNarrative(price, htf, smc, delivery, delta, zones, signal, williams, fund, hist);

    // Fetch ticker
    const ticker = await fetchTicker(currentInst);
    if (ticker) updateTicker(ticker);

    // Fetch news (less frequently)
    if (!newsCache.length || Math.random() < 0.2) {
      const rawNews = await fetchNews();
      newsCache = classifyNews(rawNews);
    }

    // Update decay counter
    if (lastSignal && lastSignal.dir !== 'NEUTRAL' && signal.dir === lastSignal.dir) {
      decayCandles++;
    } else {
      decayCandles = 0;
    }
    lastSignal = signal;
    lastConfidence = signal.confidence;

    // Update all UI
    updateSignalCard(signal, price, currentInst, currentBar);
    updateHTFBias(htf);
    updateSMCTags(smc);
    updateDeliveryModel(delivery);
    updateMarketRegime(regime);
    updateWilliamsR(williams);
    updateFunding(fund, oi);
    updateLiquidityZones(zones, price);
    updateOrderBlocks(orderBlocks, price);
    updateDeltaFlow(delta);
    updateManipulation(manip);
    updateLiquidationHeatmap(liquidHeat, price);
    updateCorrelations(corr);
    updateWhales(whale, price);
    updateNews(newsCache);
    updateHistorical(hist);
    updateEngineVotes(signal.callVotes, signal.putVotes);
    updateRiskMatrix(htf, delta, fund, smc, manip);
    updateExecutionTiming(execTiming, decayCandles);
    updateAdaptiveLearning();
    updateNarrative(narrative);
    updateScenarios(scenarios);
    drawChart(cs, signal, smc, zones);

    // Auto alerts
    if (smc.sweepDetected && smc.sweepDir) {
      const sweepMsg = smc.sweepDir === 'SSL_SWEPT'
        ? (lang==='pt'?`⚡ SSL SWEEP em ${currentInst.split('-')[0]}!`:`⚡ SSL SWEEP on ${currentInst.split('-')[0]}!`)
        : (lang==='pt'?`⚡ BSL SWEEP em ${currentInst.split('-')[0]}!`:`⚡ BSL SWEEP on ${currentInst.split('-')[0]}!`);
      showAlert(sweepMsg, `${lang==='pt'?'Caça de liquidez detectada':'Liquidity hunt detected'}`, 'warn-alert');
    }

    if (signal.dir !== 'AGUARDAR' && signal.dir !== 'NEUTRAL' && signal.confidence >= +document.getElementById('tg-conf-slider').value) {
      const tgMsg = buildTelegramMessage(signal, currentInst, currentBar, delivery, smc, delta, fund, narrative);
      sendTelegramAlert(tgMsg, signal.dir);
    }

    document.getElementById('refresh-info').textContent = lang==='pt'?`Att: ${new Date().toLocaleTimeString()}`:`Upd: ${new Date().toLocaleTimeString()}`;
    document.getElementById('chart-info').textContent = `${cs.length} ${lang==='pt'?'candles':'candles'} • ${currentBar.toUpperCase()}`;

  } catch (e) {
    console.error('Refresh error:', e);
    showAlert(lang==='pt'?'Erro de dados':'Data error', lang==='pt'?'Verifique a conexão.':'Check your connection.', 'warn-alert');
  }

  dot.classList.remove('loading');
  dot.className = 'status-dot';
}

// ============================================================
// INIT
// ============================================================

document.getElementById('asset-select').addEventListener('change', refresh);
document.getElementById('tf-select').addEventListener('change', refresh);
document.getElementById('refresh-interval').addEventListener('change', function() {
  clearInterval(refreshTimer);
  refreshTimer = setInterval(refresh, +this.value);
});

// Load saved config
(function() {
  const token = localStorage.getItem('prisma_tg_token');
  const chatId = localStorage.getItem('prisma_tg_chatid');
  if (token) document.getElementById('tg-token').value = token;
  if (chatId) document.getElementById('tg-chatid').value = chatId;
  if (token && chatId) {
    tgEnabled = true;
    document.getElementById('tg-toggle').classList.add('on');
  }
})();

// Start
refresh();
refreshTimer = setInterval(refresh, 10000);

// Handle window resize (redraw chart)
window.addEventListener('resize', () => {
  if (candles.length > 0) {
    const zones = calcLiquidityZones(candles);
    const smc = calcSMC(candles);
    if (lastSignal) drawChart(candles, lastSignal, smc, zones);
    drawCVDChart();
  }
});

</script>
