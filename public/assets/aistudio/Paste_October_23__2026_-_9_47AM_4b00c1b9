async function startGlobalScan() {
  const list = document.getElementById('scanner-list');
  const scanTime = document.getElementById('scan-time');
  list.innerHTML = `<div style="color:var(--text2);font-size:10px;text-align:center;padding:12px">${lang==='pt'?'⚡ Varrendo ativos...':'⚡ Scanning assets...'}</div>`;
  scanTime.textContent = '';

  const setDot = document.getElementById('status-dot');
  setDot.classList.add('loading');

  const results = [];
  const batch = SCAN_LIST.slice(0, 10); // Limit for browser performance

  for (const inst of batch) {
    try {
      const cs = await fetchCandles(inst, '5m', 50);
      if (cs.length < 20) continue;
      const trd = await fetchTrades(inst, 30);

      const htf = calcHTFBias(cs.slice(-20), cs.slice(-10));
      const delta = calcDeltaFlow(trd);
      const smc = calcSMC(cs);
      const delivery = calcDeliveryModel(cs, delta, null, null);
      const williams = calcWilliamsR(cs);
      const zones = calcLiquidityZones(cs);
      const obs = calcOrderBlocks(cs);
      const signal = aggregateSignal({ htf, williams, orderBlocks: obs, zones, delta, smc, delivery, execution: {}, manip: { detected: false }, funding: null, historical: {}, candles: cs });

      const minScore = +document.getElementById('sc-min-slider').value;
      if (signal.confidence >= minScore && (signal.dir === 'CALL' || signal.dir === 'PUT')) {
        results.push({ inst, signal, delivery, smc });
      }
    } catch {}
  }

  results.sort((a, b) => b.signal.confidence - a.signal.confidence);

  const now = new Date().toLocaleTimeString();
  scanTime.textContent = now;
  setDot.classList.remove('loading');

  if (results.length === 0) {
    list.innerHTML = `<div style="color:var(--text2);font-size:10px;text-align:center;padding:12px">${lang==='pt'?'Nenhum setup acima do mínimo':'No setups above minimum'}</div>`;
    return;
  }

  list.innerHTML = results.map((r, i) => {
    const sym = r.inst.split('-')[0];
    const phaseName = { ACCUMULATION: 'ACC', MANIPULATION: 'MAN', EXPANSION: 'EXP', DISTRIBUTION: 'DIS', REBALANCING: 'REB', REVERSAL: 'REV' }[r.delivery.phase] || r.delivery.phase;
    return `
      <div class="scanner-item" onclick="selectAsset('${r.inst}')">
        <span class="scanner-rank">${i+1}.</span>
        <span class="scanner-sym">${sym}</span>
        <span class="scanner-score" style="color:${r.signal.dir==='CALL'?'var(--call)':'var(--put)'}">${r.signal.confidence}%</span>
        <span class="scanner-phase" style="font-size:9px;color:var(--text2)">${r.signal.dir} • ${phaseName} ${r.smc.sweepDetected?'⚡':''}</span>
      </div>
    `;
  }).join('');
}

function selectAsset(inst) {
  document.getElementById('asset-select').value = inst;
  currentInst = inst;
  refresh();
}

