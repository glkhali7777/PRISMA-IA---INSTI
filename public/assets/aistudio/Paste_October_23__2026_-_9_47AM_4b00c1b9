// ENGINE: DELIVERY MODEL (MDM)
// ============================================================

function calcDeliveryModel(candles, delta, oi, funding) {
  if (candles.length < 30) return { phase: 'ACCUMULATION', confidence: 50, narrative: '', next: 'MANIPULATION', target: null, invalidation: 0 };
  const price = candles[candles.length - 1].close;
  const recent20 = candles.slice(-20);
  const avgRange = recent20.reduce((s, c) => s + (c.high - c.low), 0) / 20;
  const recent5 = candles.slice(-5);
  const avgRange5 = recent5.reduce((s, c) => s + (c.high - c.low), 0) / 5;
  const bodyRatio = recent5.map(c => Math.abs(c.close - c.open) / (c.high - c.low || 1)).reduce((a,b)=>a+b) / 5;

  // Calculate ATR
  const atr = calcATR(candles, 14);

  let phase = 'ACCUMULATION';
  let confidence = 60;

  // COMPRESSION/ACCUMULATION: narrow range + neutral delta
  if (avgRange5 < avgRange * 0.7 && Math.abs(delta.cvd) < 100) {
    phase = 'ACCUMULATION';
    confidence = 65;
  }
  // EXPANSION: efficient candles + strong delta
  else if (bodyRatio > 0.6 && delta.deltaStrength > 60) {
    phase = 'EXPANSION';
    confidence = 78;
  }
  // DISTRIBUTION: price stalling + CVD diverging
  else if (delta.cvdSlope === 'DOWN' && candles[candles.length-1].close > candles[candles.length-5].close) {
    phase = 'DISTRIBUTION';
    confidence = 70;
  }
  // MANIPULATION: sweep-like wick
  else if (recent5.some(c => (c.high - Math.max(c.open,c.close)) > atr * 1.5 || (Math.min(c.open,c.close) - c.low) > atr * 1.5)) {
    phase = 'MANIPULATION';
    confidence = 72;
  }
  // REBALANCING: price returning to recent midpoint
  else if (Math.abs(price - recent20.reduce((s,c)=>s+c.close,0)/20) < atr * 0.5) {
    phase = 'REBALANCING';
    confidence = 62;
  }

  const phases = ['ACCUMULATION','MANIPULATION','EXPANSION','DISTRIBUTION','REBALANCING','REVERSAL'];
  const nextPhaseMap = {
    ACCUMULATION: 'MANIPULATION', MANIPULATION: 'EXPANSION', EXPANSION: 'DISTRIBUTION',
    DISTRIBUTION: 'REBALANCING', REBALANCING: 'REVERSAL', REVERSAL: 'ACCUMULATION'
  };

  const narratives = {
    ACCUMULATION: lang === 'pt'
      ? `Mercado em fase de ACUMULAÇÃO. Delta neutro e range comprimido indicam posicionamento silencioso. Provável expansão violenta após captura de liquidez.`
