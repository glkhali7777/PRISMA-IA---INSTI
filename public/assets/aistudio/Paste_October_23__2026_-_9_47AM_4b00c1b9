// ============================================================
// ENGINE: EMA + HTF BIAS
// ============================================================

function calcEMA(closes, period) {
  const k = 2 / (period + 1);
  let e = closes[0];
  for (let i = 1; i < closes.length; i++) e = closes[i] * k + e * (1 - k);
  return e;
}

function calcHTFBias(h4, h1) {
  const toBias = (c) => {
    if (c.length < 21) return 'NEUTRAL';
    const cl = c.map(x => x.close);
    const e9 = calcEMA(cl.slice(-21), 9);
    const e21 = calcEMA(cl, 21);
    if (e9 > e21 * 1.001) return 'BULLISH';
    if (e9 < e21 * 0.999) return 'BEARISH';
    return 'NEUTRAL';
  };
  const h4b = toBias(h4), h1b = toBias(h1);
  return { h4: h4b, h1: h1b, aligned: h4b === h1b ? h4b : 'NEUTRAL' };
}

// ============================================================
// ENGINE: WILLIAMS %R
// ============================================================

function calcWilliamsR(candles, period = 14) {
  if (candles.length < period) return { value: -50, pattern: 'NEUTRAL', signal: 'WAIT', confidence: 0, desc: '' };
  const recent = candles.slice(-period);
  const hh = Math.max(...recent.map(c => c.high));
  const ll = Math.min(...recent.map(c => c.low));
  const close = candles[candles.length - 1].close;
  const wR = ll === hh ? -50 : ((hh - close) / (hh - ll)) * -100;

  // Detect W/M patterns over last 40 candles
  const lookback = candles.slice(-40);
  let pattern = 'NEUTRAL';
  let signal = 'WAIT';
  let confidence = 0;

  // Calculate W%R for each candle in lookback
  const wSeries = lookback.map((_, i) => {
    if (i < period) return -50;
    const sub = lookback.slice(i - period + 1, i + 1);
    const h = Math.max(...sub.map(c => c.high));
    const l = Math.min(...sub.map(c => c.low));
    return l === h ? -50 : ((h - sub[sub.length-1].close) / (h - l)) * -100;
  });

  // W Pattern: two lows in oversold + recovery
  const recent10 = wSeries.slice(-10);
  const lows = recent10.map((v, i) => ({ v, i })).filter(x => x.v < -80);
  const highs = recent10.map((v, i) => ({ v, i })).filter(x => x.v > -50);

  if (lows.length >= 2 && highs.length >= 1) {
    const l1 = lows[0], l2 = lows[lows.length - 1];
    const betweenHigh = highs.find(h => h.i > l1.i && h.i < l2.i);
    if (betweenHigh) { pattern = 'W'; signal = 'CALL'; confidence = 75; }
  }

  // M Pattern: two highs in overbought + dip
  const highs2 = recent10.map((v, i) => ({ v, i })).filter(x => x.v > -20);
  const lows2 = recent10.map((v, i) => ({ v, i })).filter(x => x.v < -50);
  if (highs2.length >= 2 && lows2.length >= 1) {
    const h1 = highs2[0], h2 = highs2[highs2.length - 1];
    const betweenLow = lows2.find(l => l.i > h1.i && l.i < h2.i);
    if (betweenLow) { pattern = 'M'; signal = 'PUT'; confidence = 75; }
  }

  // Simple oversold/overbought
  if (pattern === 'NEUTRAL') {
    if (wR < -80) { signal = 'CALL'; confidence = 55; pattern = 'OVERSOLD'; }
    else if (wR > -20) { signal = 'PUT'; confidence = 55; pattern = 'OVERBOUGHT'; }
  }

  let desc = '';
  if (pattern === 'W') desc = lang === 'pt' ? 'Padrão W detectado em zona sobrevendida — sinal de reversão bullish' : 'W pattern detected in oversold zone — bullish reversal signal';
  else if (pattern === 'M') desc = lang === 'pt' ? 'Padrão M detectado em zona sobrecomprada — sinal de reversão bearish' : 'M pattern detected in overbought zone — bearish reversal signal';
  else if (pattern === 'OVERSOLD') desc = lang === 'pt' ? 'Williams %R em zona de sobrevenda — atenção para reversão' : 'Williams %R in oversold zone — watch for reversal';
  else if (pattern === 'OVERBOUGHT') desc = lang === 'pt' ? 'Williams %R em zona de sobrecompra — atenção para reversão' : 'Williams %R in overbought zone — watch for reversal';
  else desc = lang === 'pt' ? 'Williams %R em zona neutra' : 'Williams %R in neutral zone';

  return { value: Math.round(wR * 10) / 10, pattern, signal, confidence, desc };
}

// ============================================================
// ENGINE: ORDER BLOCKS
// ============================================================

function calcOrderBlocks(candles) {
  const blocks = [];
  const window = 5;
  for (let i = window; i < candles.length - window; i++) {
    const c = candles[i];
    const prevHigh = Math.max(...candles.slice(i - window, i).map(x => x.high));
    const prevLow = Math.min(...candles.slice(i - window, i).map(x => x.low));
    const nextHigh = Math.max(...candles.slice(i + 1, i + window + 1).map(x => x.high));
    const nextLow = Math.min(...candles.slice(i + 1, i + window + 1).map(x => x.low));

    // Bull OB: strong bullish candle after consolidation
    if (c.close > c.open && c.close > prevHigh && c.vol > 0) {
      const bullVol = c.vol * 0.65, bearVol = c.vol * 0.35;
      blocks.push({ top: c.high, bottom: c.low, type: 'BULL', bullVol, bearVol, bullPct: 65, timestamp: c.ts, broken: false });
    }
    // Bear OB
    else if (c.close < c.open && c.close < prevLow && c.vol > 0) {
      const bearVol = c.vol * 0.65, bullVol = c.vol * 0.35;
      blocks.push({ top: c.high, bottom: c.low, type: 'BEAR', bullVol, bearVol, bullPct: 35, timestamp: c.ts, broken: false });
    }
  }

  const price = candles[candles.length - 1].close;
  // Mark broken OBs
  blocks.forEach(ob => {
    if (ob.type === 'BULL' && price < ob.bottom) ob.broken = true;
    if (ob.type === 'BEAR' && price > ob.top) ob.broken = true;
  });

  return blocks.filter(b => !b.broken).slice(-8);
}

// ============================================================
// ENGINE: LIQUIDITY ZONES
// ============================================================

function calcLiquidityZones(candles) {
  if (candles.length < 20) return { green: [], gray: [], red: [] };
  const price = candles[candles.length - 1].close;
  const highs = candles.map(c => c.high), lows = candles.map(c => c.low);
  const rangeH = Math.max(...highs), rangeL = Math.min(...lows);
  const step = (rangeH - rangeL) / 20;

  const buckets = Array.from({ length: 20 }, (_, i) => ({
    min: rangeL + i * step, max: rangeL + (i + 1) * step,
    vol: 0, delta: 0
  }));

  candles.forEach(c => {
    const mid = (c.high + c.low) / 2;
    const bi = Math.min(19, Math.floor((mid - rangeL) / step));
    if (bi >= 0) {
      buckets[bi].vol += c.vol;
      const bullVol = c.close > c.open ? c.vol * 0.65 : c.vol * 0.35;
      const bearVol = c.vol - bullVol;
      buckets[bi].delta += bullVol - bearVol;
    }
  });

  const maxVol = Math.max(...buckets.map(b => b.vol));
  const zones = { green: [], gray: [], red: [] };

  buckets.forEach(b => {
    if (b.vol < maxVol * 0.3) return;
    const strength = Math.round((b.vol / maxVol) * 100);
    const mid = (b.min + b.max) / 2;
    if (b.delta > 0 && mid < price) zones.green.push({ ...b, mid, strength });
    else if (b.delta < 0 && mid > price) zones.red.push({ ...b, mid, strength });
    else zones.gray.push({ ...b, mid, strength });
  });

  zones.green.sort((a, b) => b.strength - a.strength);
  zones.red.sort((a, b) => b.strength - a.strength);
  return zones;
}

// ============================================================
// ENGINE: DELTA FLOW / CVD
// ============================================================

function calcDeltaFlow(trades) {
  if (!trades || trades.length === 0) return { cvd: 0, cvdSlope: 'FLAT', divergence: 'NEUTRAL', deltaStrength: 50 };
  let buyVol = 0, sellVol = 0, cum = 0;
  const cvdSeries = [];
  trades.slice().reverse().forEach(t => {
    const sz = +t.sz;
    if (t.side === 'buy') { buyVol += sz; cum += sz; }
    else { sellVol += sz; cum -= sz; }
    cvdSeries.push(cum);
  });
  const delta = buyVol - sellVol;
  const total = buyVol + sellVol;
  const strength = total > 0 ? Math.round(Math.abs(delta) / total * 100) : 50;
  const slope = cvdSeries.length < 5 ? 'FLAT' :
    cvdSeries[cvdSeries.length - 1] > cvdSeries[cvdSeries.length - 5] ? 'UP' : 'DOWN';
  cvdHistory = cvdSeries.slice(-50);
  return { cvd: Math.round(cum * 100) / 100, cvdSlope: slope, divergence: 'NEUTRAL', deltaStrength: strength, buyVol, sellVol };
}

// ============================================================
// ENGINE: SMART MONEY CONCEPTS
// ============================================================

function calcSMC(candles) {
  if (candles.length < 20) return { fvgs: [], choch: null, sweepDetected: false, sweepDir: null, bsl: null, ssl: null, bos: false };
  const price = candles[candles.length - 1].close;

  // FVGs
  const fvgs = [];
  for (let i = 2; i < candles.length; i++) {
    const c1 = candles[i - 2], c3 = candles[i];
    if (c3.low > c1.high) fvgs.push({ type: 'BULLISH', top: c3.low, bottom: c1.high, mitigated: price < c3.low });
    else if (c3.high < c1.low) fvgs.push({ type: 'BEARISH', top: c1.low, bottom: c3.high, mitigated: price > c1.low });
  }

  // Swing highs / lows for BOS, CHoCH, sweeps, BSL/SSL
  const highs = [], lows = [];
  for (let i = 3; i < candles.length - 3; i++) {
    const isSwingH = candles.slice(i-3,i).every(c=>c.high<=candles[i].high) && candles.slice(i+1,i+4).every(c=>c.high<=candles[i].high);
    const isSwingL = candles.slice(i-3,i).every(c=>c.low>=candles[i].low) && candles.slice(i+1,i+4).every(c=>c.low>=candles[i].low);
    if (isSwingH) highs.push({ price: candles[i].high, i, ts: candles[i].ts });
    if (isSwingL) lows.push({ price: candles[i].low, i, ts: candles[i].ts });
  }

  const bsl = highs.length > 0 ? Math.max(...highs.map(h => h.price)) : null;
  const ssl = lows.length > 0 ? Math.min(...lows.map(l => l.price)) : null;

  // Sweep detection
  const lastCandle = candles[candles.length - 1];
  let sweepDetected = false, sweepDir = null;
  if (bsl && lastCandle.high > bsl && lastCandle.close < bsl) { sweepDetected = true; sweepDir = 'BSL_SWEPT'; }
  if (ssl && lastCandle.low < ssl && lastCandle.close > ssl) { sweepDetected = true; sweepDir = 'SSL_SWEPT'; }

  // BOS detection
  const bos = bsl && price > bsl;
  const choch = bos ? { direction: 'BULLISH', price: bsl } : null;

  // EQH / EQL
  const eqhPairs = [];
  for (let i = 0; i < highs.length - 1; i++) {
    for (let j = i + 1; j < highs.length; j++) {
      if (Math.abs(highs[i].price - highs[j].price) / highs[i].price < 0.002) {
        eqhPairs.push({ price: (highs[i].price + highs[j].price) / 2 });
      }
    }
  }
  const eqlPairs = [];
  for (let i = 0; i < lows.length - 1; i++) {
    for (let j = i + 1; j < lows.length; j++) {
      if (Math.abs(lows[i].price - lows[j].price) / lows[i].price < 0.002) {
        eqlPairs.push({ price: (lows[i].price + lows[j].price) / 2 });
      }
    }
  }

  return { fvgs: fvgs.slice(-5), choch, sweepDetected, sweepDir, bsl, ssl, bos, eqh: eqhPairs[0]?.price || null, eql: eqlPairs[0]?.price || null };
}

