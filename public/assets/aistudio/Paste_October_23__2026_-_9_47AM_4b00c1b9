    EXPANSION: lang === 'pt'
      ? `Mercado em EXPANSÃO. Velas eficientes + delta forte confirmam entrada de capital. Seguir fluxo.`
      : `Market in EXPANSION. Efficient candles + strong delta confirm capital entry. Follow the flow.`,
    DISTRIBUTION: lang === 'pt'
      ? `DISTRIBUIÇÃO institucional detectada. CVD desacelerando enquanto preço sobe. Risco de reversão aumentando.`
      : `Institutional DISTRIBUTION detected. CVD decelerating while price rises. Reversal risk increasing.`,
    REBALANCING: lang === 'pt'
      ? `Fase de REBALANCEAMENTO. Mercado retornando para FVG/POC. Aguardar novo impulso direcional.`
      : `REBALANCING phase. Market returning to FVG/POC. Wait for new directional impulse.`,
    REVERSAL: lang === 'pt'
      ? `Possível REVERSÃO estrutural. CHoCH detectado. Monitorar absorção na nova direção.`
