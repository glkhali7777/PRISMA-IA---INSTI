function drawChart(candles, signal, smc, zones) {
  const canvas = document.getElementById('chart-canvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.offsetWidth || 600;
  const H = 240;
  canvas.width = W; canvas.height = H;
  ctx.clearRect(0, 0, W, H);

  if (!candles || candles.length < 5) return;

  const visible = candles.slice(-80);
  const highs = visible.map(c => c.high), lows = visible.map(c => c.low);
  const maxP = Math.max(...highs) * 1.002, minP = Math.min(...lows) * 0.998;
  const priceRange = maxP - minP;
  const candleW = Math.max(2, (W - 40) / visible.length);
  const chartW = W - 40;
  const toY = p => H - 20 - ((p - minP) / priceRange) * (H - 30);

  // Background grid
  ctx.strokeStyle = '#1a1a40';
  ctx.lineWidth = 0.5;
  for (let i = 0; i <= 4; i++) {
    const y = 10 + (i / 4) * (H - 30);
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    const p = maxP - (i / 4) * priceRange;
    ctx.fillStyle = '#4040608'; ctx.font = '9px Space Mono';
    ctx.fillStyle = '#70709090'; ctx.fillText(fmtPrice(p), W - 38, y + 3);
  }

  // Zone overlays
  zones.green.slice(0, 2).forEach(z => {
    const y1 = toY(z.max), y2 = toY(z.min);
    ctx.fillStyle = 'rgba(0,230,118,0.05)';
    ctx.fillRect(0, y1, chartW, y2 - y1);
    ctx.strokeStyle = 'rgba(0,230,118,0.3)'; ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(0, toY(z.mid)); ctx.lineTo(chartW, toY(z.mid)); ctx.stroke();
  });

  zones.red.slice(0, 2).forEach(z => {
    const y1 = toY(z.max), y2 = toY(z.min);
    ctx.fillStyle = 'rgba(255,23,68,0.05)';
    ctx.fillRect(0, y1, chartW, y2 - y1);
    ctx.strokeStyle = 'rgba(255,23,68,0.3)'; ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(0, toY(z.mid)); ctx.lineTo(chartW, toY(z.mid)); ctx.stroke();
  });

  // BSL / SSL lines
  if (smc.bsl) {
    ctx.strokeStyle = 'rgba(100,181,246,0.6)'; ctx.lineWidth = 0.8;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(0, toY(smc.bsl)); ctx.lineTo(chartW, toY(smc.bsl)); ctx.stroke();
    ctx.fillStyle = 'rgba(100,181,246,0.9)'; ctx.font = '9px Space Mono';
    ctx.fillText('BSL', 2, toY(smc.bsl) - 3);
    ctx.setLineDash([]);
  }

  if (smc.ssl) {
    ctx.strokeStyle = 'rgba(255,138,101,0.6)'; ctx.lineWidth = 0.8;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(0, toY(smc.ssl)); ctx.lineTo(chartW, toY(smc.ssl)); ctx.stroke();
    ctx.fillStyle = 'rgba(255,138,101,0.9)'; ctx.font = '9px Space Mono';
    ctx.fillText('SSL', 2, toY(smc.ssl) + 10);
    ctx.setLineDash([]);
  }

  // Candles
  visible.forEach((c, i) => {
    const x = i * candleW + candleW / 2;
    const isBull = c.close >= c.open;
    const color = isBull ? '#00e676' : '#ff1744';

    // Wick
    ctx.strokeStyle = color + '80'; ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, toY(c.high)); ctx.lineTo(x, toY(c.low));
    ctx.stroke();

    // Body
    const bodyTop = toY(Math.max(c.open, c.close));
    const bodyBot = toY(Math.min(c.open, c.close));
    const bodyH = Math.max(1, bodyBot - bodyTop);
    ctx.fillStyle = isBull ? '#00e67690' : '#ff174490';
    ctx.fillRect(x - candleW * 0.35, bodyTop, candleW * 0.7, bodyH);
  });

  // Current price line
  const price = candles[candles.length - 1].close;
  ctx.strokeStyle = 'rgba(255,214,0,0.8)'; ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  ctx.beginPath(); ctx.moveTo(0, toY(price)); ctx.lineTo(chartW, toY(price)); ctx.stroke();
  ctx.setLineDash([]);

  // Price label
  ctx.fillStyle = '#ffd600'; ctx.font = 'bold 10px Syne';
  ctx.fillText(fmtPrice(price), chartW + 2, toY(price) + 4);

  // Signal annotation
  if (signal && signal.dir !== 'NEUTRAL' && signal.dir !== 'AGUARDAR') {
    const sy = toY(price);
    ctx.fillStyle = signal.dir === 'CALL' ? '#00e67640' : '#ff174440';
    ctx.fillRect(W - 80, sy - 20, 75, 20);
    ctx.strokeStyle = signal.dir === 'CALL' ? '#00e676' : '#ff1744'; ctx.lineWidth = 1;
    ctx.strokeRect(W - 80, sy - 20, 75, 20);
    ctx.fillStyle = signal.dir === 'CALL' ? '#00e676' : '#ff1744'; ctx.font = 'bold 10px Syne';
    ctx.fillText(`${signal.dir} ${signal.confidence}%`, W - 76, sy - 7);
  }
}

